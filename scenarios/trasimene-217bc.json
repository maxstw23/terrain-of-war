  "overlays": [],
  "steps": [
    {
      "title": "Drawing Flaminius after him",
      "text": "Flaminius is camped at Arretium. Hannibal, judging him rash and eager for glory, marches past him towards Rome, plundering as he goes, to provoke him into following. Flaminius follows.",
      "focus": [
        "hannibal-march",
        "flaminius-follows",
        "arretium",
        "cortona"
      ],
      "camera": {
        "center": [12, 43.3],
        "zoom": 9.6
      },
      "zh": {
        "title": "诱敌尾随",
        "text": "弗拉米尼乌斯驻扎在阿雷提乌姆。汉尼拔判断他鲁莽好名，便从他旁边经过，向罗马进军，沿途焚掠，诱他追来。弗拉米尼乌斯果然尾随而至。"
      }
    },
    {
      "title": "A valley between the hills and the lake",
      "text": "Near the lake Hannibal finds the place he wants: a narrow strip of level ground with a line of hills on one side and the lake on the other, a steep hill at the far end and a narrow way in.\n\nThe cross-section from the lake up into the hills shows how little room there is between them.",
      "focus": [
        "valley",
        "entrance",
        "passignano",
        "hannibal-hill"
      ],
      "camera": {
        "center": [12.08, 43.2],
        "zoom": 11.8
      },
      "analysis": {
        "type": "profile",
        "coords": [[12.08, 43.17], [12.08, 43.24]],
        "label": "From the lake up into the hills",
        "zh": {
          "label": "从湖面到山上的剖面"
        }
      },
      "zh": {
        "title": "山湖之间的谷地",
        "text": "在湖边，汉尼拔找到了他要的地方：一条狭长的平地，一侧是连绵的山，一侧是湖，尽头有一座陡峭的高地，入口狭窄。\n\n从湖面到山上的剖面，显示两者之间的空间有多么局促。"
      }
    },
    {
      "title": "Setting the trap",
      "text": "Hannibal camps on the hill at the far end with his African and Spanish infantry, in plain view. He sends the Balearic slingers and light troops round behind the hills along the valley, and posts the cavalry and the Gauls behind the hills near the entrance, so that once the Romans are inside they will be shut in by the lake and the hills.",
      "focus": [
        "hannibal-hill",
        "light-troops",
        "cavalry",
        "hidden-slopes",
        "valley"
      ],
      "camera": {
        "center": [12.08, 43.205],
        "zoom": 12
      },
      "zh": {
        "title": "布下陷阱",
        "text": "汉尼拔率非洲和西班牙步兵驻扎在尽头的高地上，公然可见。他派巴利阿里投石手和轻装部队绕到谷地沿线的山后，又把骑兵和高卢人布置在入口附近的山后，等罗马人一进来，便被湖和山关在里面。"
      }
    },
    {
      "title": "Into the mist",
      "text": "Flaminius reaches the lake late in the evening and camps near the entrance. At dawn he leads his column into the valley. Thick mist lies on the lake and the low ground, while the hilltops are clear: Hannibal can see the whole column, and the Romans can see almost nothing.\n\nThe viewshed from the road in the middle of the valley shows how much of the hillsides a Roman could have seen even without the mist: the troops behind the crests were in dead ground.",
      "focus": [
        "roman-column",
        "valley",
        "hidden-slopes"
      ],
      "camera": {
        "center": [12.08, 43.205],
        "zoom": 12
      },
      "analysis": {
        "type": "viewshed",
        "at": [12.08, 43.197],
        "radiusKm": 4,
        "observerH": 2,
        "label": "the road in the middle of the valley",
        "zh": {
          "label": "谷地中段的道路"
        },
        "expect": {
          "hidden": [
            "light-troops",
            "cavalry"
          ]
        }
      },
      "zh": {
        "title": "走进浓雾",
        "text": "弗拉米尼乌斯傍晚到达湖边，在入口附近扎营。黎明时，他率纵队进入谷地。湖面和低地上弥漫着浓雾，山顶却很清朗：汉尼拔能看见整支罗马纵队，罗马人却几乎什么也看不见。\n\n从谷地中段道路看出去的可视域，显示即使没有雾，罗马人能看到多少山坡：藏在山脊后面的部队都处在视线死角里。"
      }
    },
    {
      "title": "Attacked from every side",
      "text": "When the head of the column nears the hill at the far end, Hannibal gives the signal and every part of his army attacks at once from the hills, while the cavalry closes the entrance behind. The Romans cannot see where the enemy is or form up, and are cut down where they stand; many are driven into the lake. Flaminius is killed.",
      "focus": [
        "light-attack",
        "cavalry-close",
        "roman-column",
        "valley"
      ],
      "camera": {
        "center": [12.08, 43.205],
        "zoom": 12
      },
      "zh": {
        "title": "四面受敌",
        "text": "当纵队前锋接近尽头的高地时，汉尼拔发出信号，全军同时从山上冲下，骑兵则在后面封住入口。罗马人看不见敌人在哪里，也无法列阵，在原地被砍倒，许多人被逼进湖里。弗拉米尼乌斯战死。"
      }
    },
    {
      "title": "The vanguard breaks out",
      "text": "About six thousand men at the head of the column fight their way through and out of the valley, but are surrounded and surrender the next day. Some fifteen thousand Romans have died in the valley.",
      "focus": [
        "vanguard-breaks",
        "passignano"
      ],
      "camera": {
        "center": [12.13, 43.2],
        "zoom": 11.6
      },
      "zh": {
        "title": "前锋突围",
        "text": "纵队前部约六千人杀出谷地，但次日被包围后投降。约一万五千名罗马人死在谷中。"
      }
    }
  ]
