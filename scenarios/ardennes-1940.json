  "places": [
    {
      "id": "r-belgian-plain",
      "name": "Central Belgian plain",
      "kind": "region",
      "lon": 4.3,
      "lat": 50.8,
      "approximate": false,
      "zh": {
        "name": "比利时中部平原"
      }
    },
    {
      "id": "r-lorraine",
      "name": "Lorraine",
      "kind": "region",
      "lon": 6.4,
      "lat": 49.05,
      "approximate": false,
      "zh": {
        "name": "洛林"
      }
    },
    {
      "id": "sedan",
      "name": "Sedan",
      "kind": "battle",
      "side": "de",
      "lon": 4.94,
      "lat": 49.7,
      "note": "Guderian's XIX Panzer Corps forced the Meuse here on 13 May 1940, behind the heaviest air bombardment of the campaign. The French 55th Division — older reservists — broke.",
      "zh": {
        "name": "色当",
        "note": "1940年5月13日，古德里安的第19装甲军在空军规模最大的一次轰炸掩护下在此强渡默兹河。由老龄预备役人员组成的法军第55师崩溃。"
      }
    },
    {
      "id": "marfee",
      "name": "Marfée heights",
      "kind": "mountain",
      "side": "allies",
      "lon": 4.9,
      "lat": 49.67,
      "approximate": true,
      "note": "The wooded ridge south of the Meuse bend that overlooks Sedan and the crossing sites. French artillery observers here could see every move in the river loop — until the Stukas and the infantry assault drove them off.",
      "zh": {
        "name": "马尔菲高地",
        "note": "默兹河弯道以南、俯瞰色当和各渡河点的林木覆盖的山脊。法军炮兵观察员在此可以看清河湾里的一举一动——直到斯图卡和步兵突击把他们赶走。"
      }
    },
    {
      "id": "montherme",
      "name": "Monthermé",
      "kind": "battle",
      "side": "de",
      "lon": 4.73,
      "lat": 49.88,
      "note": "Reinhardt's XLI Panzer Corps crossed in the Meuse gorge here: steep wooded slopes 200 m high on both banks. A single French colonial machine-gun half-brigade held the panzers for two days.",
      "zh": {
        "name": "蒙泰尔梅",
        "note": "莱因哈特的第41装甲军在此处的默兹河峡谷渡河：两岸是200米高、林木茂密的陡坡。仅一个法国殖民地机枪半旅就把装甲部队挡了两天。"
      }
    },
    {
      "id": "dinant",
      "name": "Dinant / Houx",
      "kind": "battle",
      "side": "de",
      "lon": 4.9,
      "lat": 50.28,
      "note": "Rommel's 7th Panzer Division found an unguarded weir at Houx on 12–13 May and got infantry across the Meuse before the French were in position.",
      "zh": {
        "name": "迪南 / 乌克斯",
        "note": "隆美尔的第7装甲师在乌克斯发现一座无人看守的拦河坝，于5月12—13日在法军就位前把步兵送过了默兹河。"
      }
    },
    {
      "id": "luxembourg",
      "name": "Luxembourg",
      "kind": "city",
      "lon": 6.13,
      "lat": 49.61,
      "note": "Neutral and undefended; overrun on 10 May. Its roads gave the panzer columns a quick start westward.",
      "zh": {
        "name": "卢森堡",
        "note": "中立且不设防，5月10日即被占领。它的道路让装甲纵队得以迅速西进。"
      }
    },
    {
      "id": "bastogne",
      "name": "Bastogne",
      "kind": "city",
      "lon": 5.72,
      "lat": 50,
      "note": "Road hub of the Belgian Ardennes (and of the 1944 battle).",
      "zh": {
        "name": "巴斯托涅",
        "note": "比利时阿登地区的交通枢纽（也是1944年那场战役的焦点）。"
      }
    },
    {
      "id": "bouillon",
      "name": "Bouillon",
      "kind": "city",
      "lon": 5.07,
      "lat": 49.79,
      "note": "On the Semois, a deep, winding valley that the Belgian and French cavalry screen was meant to hold. It delayed the Germans by hours, not days.",
      "zh": {
        "name": "布永",
        "note": "位于瑟穆瓦河畔，这条深切、曲折的河谷本应由比利时和法国的骑兵掩护部队坚守。它只迟滞了德军几个小时，而不是几天。"
      }
    },
    {
      "id": "longuyon",
      "name": "Longuyon",
      "kind": "fort",
      "side": "allies",
      "lon": 5.6,
      "lat": 49.44,
      "note": "Western end of the main Maginot Line. West of here, facing the Ardennes, the line thinned to a few isolated works such as La Ferté.",
      "zh": {
        "name": "隆吉永",
        "note": "马其诺防线主体的西端。从这里往西、面对阿登的一段，防线只剩下拉费尔泰等少数孤立工事。"
      }
    },
    {
      "id": "laferte",
      "name": "La Ferté",
      "kind": "fort",
      "side": "allies",
      "lon": 5.24,
      "lat": 49.59,
      "approximate": true,
      "note": "Small Maginot work on the extension toward Sedan, overrun on 19 May with its whole garrison killed.",
      "zh": {
        "name": "拉费尔泰",
        "note": "马其诺防线向色当延伸段上的一座小型工事，5月19日被攻陷，守军全部阵亡。"
      }
    },
    {
      "id": "gembloux",
      "name": "Gembloux",
      "kind": "battle",
      "side": "allies",
      "lon": 4.69,
      "lat": 50.56,
      "note": "The open 'Gembloux gap' between the Dyle and Meuse, the classic invasion corridor. The French First Army held the German panzers here on 14–15 May — exactly where France expected the battle to be.",
      "zh": {
        "name": "让布卢",
        "note": "代尔河与默兹河之间开阔的“让布卢缺口”，是传统的入侵通道。法国第1集团军于5月14—15日在此挡住了德军装甲部队——恰恰是法国预料决战发生的地方。"
      }
    },
    {
      "id": "wavre",
      "name": "Wavre (Dyle line)",
      "kind": "fort",
      "side": "allies",
      "lon": 4.61,
      "lat": 50.72,
      "zh": {
        "name": "瓦夫尔（代尔防线）"
      }
    },
    {
      "id": "eben-emael",
      "name": "Eben-Emael",
      "kind": "fort",
      "side": "allies",
      "lon": 5.68,
      "lat": 50.8,
      "note": "Belgium's strongest fort, taken on 10 May by glider-borne pioneers landing on its roof. Spectacular — and part of the lure that drew Allied eyes north.",
      "zh": {
        "name": "埃本-埃马尔",
        "note": "比利时最坚固的要塞，5月10日被乘滑翔机降落在其顶部的德军工兵攻占。场面惊人——也是把盟军目光引向北方的诱饵的一部分。"
      }
    },
    {
      "id": "montcornet",
      "name": "Montcornet",
      "kind": "battle",
      "side": "allies",
      "lon": 3.98,
      "lat": 49.69,
      "note": "De Gaulle's improvised 4th Armoured Division counter-attacked the panzer corridor's flank here on 17 May.",
      "zh": {
        "name": "蒙科尔内",
        "note": "5月17日，戴高乐临时拼凑的第4装甲师在此对德军装甲走廊的侧翼发动反击。"
      }
    },
    {
      "id": "arras",
      "name": "Arras",
      "kind": "battle",
      "side": "allies",
      "lon": 2.78,
      "lat": 50.29,
      "note": "British counter-attack on 21 May; it shook Rommel but was too small to cut the corridor.",
      "zh": {
        "name": "阿拉斯",
        "note": "5月21日英军的反击，让隆美尔吃了一惊，但规模太小，无法切断走廊。"
      }
    },
    {
      "id": "abbeville",
      "name": "Abbeville",
      "kind": "city",
      "side": "de",
      "lon": 1.83,
      "lat": 50.11,
      "note": "2nd Panzer Division reached the Channel at the Somme estuary on the evening of 20 May. The Allied armies in Belgium were cut off.",
      "zh": {
        "name": "阿布维尔",
        "note": "5月20日晚，第2装甲师在索姆河口抵达海峡。比利时境内的盟军被切断。"
      }
    },
    {
      "id": "dunkirk",
      "name": "Dunkirk",
      "kind": "port",
      "side": "allies",
      "lon": 2.38,
      "lat": 51.03,
      "note": "The pocket's last port: 338,000 Allied troops were evacuated by 4 June.",
      "zh": {
        "name": "敦刻尔克",
        "note": "包围圈中最后的港口：到6月4日共撤出盟军33.8万人。"
      }
    }
  ],
  "routes": [
    {
      "id": "guderian",
      "name": "XIX Panzer Corps (Guderian)",
      "kind": "advance",
      "side": "de",
      "waypoints": [
        [6.22, 49.93],
        [5.74, 49.83],
        [5.43, 49.84],
        "bouillon",
        "sedan"
      ],
      "note": "Through northern Luxembourg and the Belgian Ardennes. Kleist's panzer group formed the greatest traffic jam in history to that date — at one point a column 250 km long — but Allied aircraft never seriously attacked it.",
      "zh": {
        "name": "第19装甲军（古德里安）",
        "note": "穿过卢森堡北部和比利时阿登。克莱斯特装甲集群造成了当时史上最大的交通堵塞——一度绵延250公里——但盟军空军始终没有认真攻击它。"
      }
    },
    {
      "id": "reinhardt",
      "name": "XLI Panzer Corps (Reinhardt)",
      "kind": "advance",
      "side": "de",
      "waypoints": [
        [6.12, 50.28],
        [5.6, 50.05],
        [5.12, 49.93],
        "montherme"
      ],
      "zh": {
        "name": "第41装甲军（莱因哈特）"
      }
    },
    {
      "id": "rommel",
      "name": "XV Panzer Corps (Hoth, Rommel)",
      "kind": "advance",
      "side": "de",
      "waypoints": [
        [6.12, 50.36],
        [5.34, 50.23],
        "dinant"
      ],
      "zh": {
        "name": "第15装甲军（霍特、隆美尔）"
      }
    },
    {
      "id": "army-b",
      "name": "Army Group B (the lure)",
      "kind": "advance",
      "side": "de",
      "waypoints": [
        [6.08, 50.78],
        [5.69, 50.85],
        [5.08, 50.67],
        "gembloux"
      ],
      "note": "Loud, visible, and with airborne coups at Eben-Emael and in the Netherlands. It looked like the main effort — the 1914 Schlieffen route again — and fixed the Allied armies on the Dyle.",
      "zh": {
        "name": "B集团军群（诱饵）",
        "note": "声势浩大、引人注目，还有在埃本-埃马尔和荷兰的空降奇袭。它看上去像是主攻方向——又一次1914年施里芬路线——并把盟军牢牢吸在代尔河一线。"
      }
    },
    {
      "id": "dyle",
      "name": "Allied advance to the Dyle",
      "kind": "advance",
      "side": "allies",
      "waypoints": [
        [3.97, 50.28],
        [4.45, 50.45],
        "gembloux"
      ],
      "note": "The Dyle Plan: on 10 May the French First Army and the BEF wheeled into Belgium — moving the Allies' most mobile forces away from the Ardennes.",
      "zh": {
        "name": "盟军向代尔河推进",
        "note": "代尔计划：5月10日，法国第1集团军和英国远征军转入比利时——把盟军机动性最强的部队调离了阿登。"
      }
    },
    {
      "id": "bef",
      "name": "BEF",
      "kind": "advance",
      "side": "allies",
      "waypoints": [
        [3.06, 50.63],
        [4.1, 50.75],
        "wavre"
      ],
      "zh": {
        "name": "英国远征军"
      }
    },
    {
      "id": "sickle",
      "name": "Sickle cut to the Channel",
      "kind": "advance",
      "side": "de",
      "waypoints": [
        "sedan",
        "montcornet",
        [3.29, 49.85],
        [2.93, 49.93],
        [2.3, 49.89],
        "abbeville"
      ],
      "note": "Once across the Meuse the panzers turned west, not south toward Paris or the Maginot Line's rear, and ran 250 km to the sea in a week.",
      "zh": {
        "name": "“镰刀收割”直抵海峡",
        "note": "渡过默兹河后，装甲部队没有南下巴黎或迂回马其诺防线后方，而是转向西进，一周内奔袭250公里直抵海边。"
      }
    },
