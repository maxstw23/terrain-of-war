{
 "$defs": {
  "Analysis": {
   "properties": {
    "type": {
     "enum": [
      "profile",
      "viewshed",
      "los",
      "compare"
     ],
     "type": "string"
    },
    "route": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "route id, for profile"
    },
    "routes": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "description": "2-4 route ids, for compare (alternative routes side by side)"
    },
    "coords": {
     "anyOf": [
      {
       "items": {
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "description": "ad-hoc profile line, e.g. a cross-section of a gorge"
    },
    "at": {
     "anyOf": [
      {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "description": "observer [lon, lat], for viewshed"
    },
    "from": {
     "anyOf": [
      {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "description": "observer [lon, lat], for los"
    },
    "to": {
     "anyOf": [
      {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "description": "target [lon, lat], for los"
    },
    "radiusKm": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "observerH": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "description": "eye height above ground in m (tower 10-20, rider 3)"
    },
    "expect": {
     "anyOf": [
      {
       "$ref": "#/$defs/Expect"
      },
      {
       "type": "null"
      }
     ],
     "description": "what the step text says this analysis shows; checked against the terrain"
    },
    "label": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "zh": {
     "anyOf": [
      {
       "$ref": "#/$defs/ZhLabel"
      },
      {
       "type": "null"
      }
     ],
     "description": "Chinese label, when label is set"
    }
   },
   "required": [
    "type"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "Camera": {
   "properties": {
    "center": {
     "items": {
      "type": "number"
     },
     "type": "array"
    },
    "zoom": {
     "description": "6 = region, 9 = valley, 11-12 = single battlefield (flat north-up map)",
     "type": "number"
    }
   },
   "required": [
    "center",
    "zoom"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "Expect": {
   "properties": {
    "sight": {
     "anyOf": [
      {
       "enum": [
        "blocked",
        "clear"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "for los: the text says the line of sight is blocked / clear"
    },
    "hidden": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "description": "place ids the text says the observer cannot see (viewshed or los observer)"
    },
    "visible": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "description": "place ids the text says the observer can see"
    }
   },
   "type": "object",
   "additionalProperties": false
  },
  "Place": {
   "properties": {
    "id": {
     "description": "short kebab-case id, unique across the scenario",
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "nameLocal": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "name in the local language/script, e.g. 街亭"
    },
    "kind": {
     "description": "\"region\" is a name label for a basin, plain, plateau or range (e.g. 汉中盆地), drawn without a symbol",
     "enum": [
      "city",
      "fort",
      "pass",
      "mountain",
      "river",
      "battle",
      "camp",
      "port",
      "landmark",
      "region"
     ],
     "type": "string"
    },
    "side": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "side id controlling it at the time, if any"
    },
    "lon": {
     "type": "number"
    },
    "lat": {
     "type": "number"
    },
    "approximate": {
     "description": "true if the historical site is uncertain or your coordinates are rough",
     "type": "boolean"
    },
    "note": {
     "description": "1-3 sentences: what happened here and why its terrain mattered",
     "type": "string"
    },
    "zh": {
     "$ref": "#/$defs/ZhNamed"
    }
   },
   "required": [
    "id",
    "name",
    "kind",
    "lon",
    "lat",
    "approximate",
    "note",
    "zh"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "Route": {
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "advance",
      "retreat",
      "supply",
      "feint",
      "planned",
      "road",
      "river"
     ],
     "type": "string"
    },
    "side": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "waypoints": {
     "description": "ordered [lon, lat] waypoints at known stations along the route",
     "items": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "type": "array"
    },
    "follow": {
     "anyOf": [
      {
       "enum": [
        "terrain",
        "valley"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "\"terrain\" for foot/horse marches through mountains: the app replaces the line with the least-effort path through the elevation model between waypoints. \"valley\" for rivers: the line is snapped to the valley floor between waypoints (give points on the river, in order). Omit for schematic arrows."
    },
    "note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "zh": {
     "$ref": "#/$defs/ZhNamed"
    }
   },
   "required": [
    "id",
    "name",
    "kind",
    "waypoints",
    "zh"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "Side": {
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "color": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "CSS hex colour, e.g. #d64545"
    },
    "zh": {
     "$ref": "#/$defs/ZhName"
    }
   },
   "required": [
    "id",
    "name",
    "zh"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "Step": {
   "properties": {
    "text": {
     "description": "2-3 short paragraphs separated by blank lines",
     "type": "string"
    },
    "focus": {
     "description": "ids of places/routes/zones to highlight in this step",
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "camera": {
     "anyOf": [
      {
       "$ref": "#/$defs/Camera"
      },
      {
       "type": "null"
      }
     ],
     "description": "usually omit: the app frames the step's focus and analysis itself; only for a step with neither"
    },
    "analysis": {
     "anyOf": [
      {
       "$ref": "#/$defs/Analysis"
      },
      {
       "type": "null"
      }
     ]
    },
    "zh": {
     "$ref": "#/$defs/ZhStep"
    }
   },
   "required": [
    "title",
    "text",
    "focus",
    "zh"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "ZhLabel": {
   "properties": {
    "label": {
     "type": "string"
    }
   },
   "required": [
    "label"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "ZhName": {
   "properties": {
    "name": {
     "description": "Simplified Chinese name",
     "type": "string"
    }
   },
   "required": [
    "name"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "ZhNamed": {
   "properties": {
    "name": {
     "description": "Simplified Chinese name, e.g. 街亭, 色当",
     "type": "string"
    },
    "note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "Simplified Chinese translation of note"
    }
   },
   "required": [
    "name"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "ZhScenario": {
   "properties": {
    "period": {
     "type": "string"
    },
    "summary": {
     "type": "string"
    },
    "sources": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "title",
    "period",
    "summary",
    "sources"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "ZhStep": {
   "properties": {
    "text": {
     "type": "string"
    }
   },
   "required": [
    "title",
    "text"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "Zone": {
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "ambush",
      "killzone",
      "defense",
      "obstacle",
      "control",
      "flood",
      "forest",
      "marsh"
     ],
     "type": "string"
    },
    "side": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "coords": {
     "anyOf": [
      {
       "items": {
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "description": "polygon ring of [lon, lat]"
    },
    "center": {
     "anyOf": [
      {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "description": "circle centre [lon, lat], with radiusKm"
    },
    "radiusKm": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "line": {
     "anyOf": [
      {
       "items": {
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "description": "polyline for a corridor (defensive line), with widthKm"
    },
    "widthKm": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "zh": {
     "$ref": "#/$defs/ZhNamed"
    }
   },
   "required": [
    "id",
    "name",
    "kind",
    "zh"
   ],
   "type": "object",
   "additionalProperties": false
  }
 },
 "properties": {
  "period": {
   "type": "string"
  },
  "summary": {
   "type": "string"
  },
  "sources": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "sides": {
   "items": {
    "$ref": "#/$defs/Side"
   },
   "type": "array"
  },
  "places": {
   "items": {
    "$ref": "#/$defs/Place"
   },
   "type": "array"
  },
  "routes": {
   "items": {
    "$ref": "#/$defs/Route"
   },
   "type": "array"
  },
  "zones": {
   "items": {
    "$ref": "#/$defs/Zone"
   },
   "type": "array"
  },
  "steps": {
   "items": {
    "$ref": "#/$defs/Step"
   },
   "type": "array"
  },
  "zh": {
   "$ref": "#/$defs/ZhScenario"
  }
 },
 "required": [
  "title",
  "period",
  "summary",
  "sources",
  "sides",
  "places",
  "routes",
  "zones",
  "steps",
  "zh"
 ],
 "type": "object",
 "additionalProperties": false
}
